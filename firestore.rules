rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // TobiServices profile data. Password material and account control data
    // are stored in tobiAccounts and are never exposed to clients.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /tobiAccounts/{usernameKey} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
