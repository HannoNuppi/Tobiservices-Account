rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function ownProfile(uid) { return signedIn() && request.auth.uid == uid; }

    function isAccountUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tags is list
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tags.hasAny(['admin', 'Admin', 'ADMIN'])
        && (!('disabled' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled != true);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function validProfileTitle(value) {
      return value is string
        && value in ['', 'Newcomer', 'Dance Fan', 'Gold Collector',
          'Theme Hunter', 'Night Owl', 'Legend'];
    }

    function validProfileIcon(value) {
      return value is string
        && value in ['', '🎮', '🦊', '🐱', '🐸', '🐼', '🐉', '🦄',
          '👾', '🎃', '⭐', '💎', '🌈', '🪩'];
    }
    function validAccessControl(data) {
      return data.keys().hasAll(['tags', 'permissions', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['tags', 'permissions', 'updatedAt', 'updatedBy'])
        && data.tags is list
        && data.tags.size() >= 1
        && data.tags.size() <= 100
        && data.tags.hasAny(['admin'])
        && data.permissions is map
        && data.permissions.keys().hasOnly(['test-mode', 'jdnext', 'untis-next', 'account-apk'])
        && data.permissions['test-mode'] is list
        && data.permissions['jdnext'] is list
        && data.permissions['untis-next'] is list
        && data.permissions['account-apk'] is list
        && data.permissions['test-mode'].size() <= 100
        && data.permissions['jdnext'].size() <= 100
        && data.permissions['untis-next'].size() <= 100
        && data.permissions['account-apk'].size() <= 100
        && data.tags.hasAll(data.permissions['test-mode'])
        && data.tags.hasAll(data.permissions['jdnext'])
        && data.tags.hasAll(data.permissions['untis-next'])
        && data.tags.hasAll(data.permissions['account-apk'])
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validDeploymentRequest(data) {
      return data.keys().hasAll(['requestId', 'target', 'requestedBy', 'requestedAt', 'note'])
        && data.keys().hasOnly(['requestId', 'target', 'requestedBy', 'requestedAt', 'note'])
        && data.requestId is string
        && data.requestId.size() >= 8
        && data.requestId.size() <= 100
        && data.target == 'untis-next'
        && data.requestedBy == request.auth.uid
        && data.requestedAt == request.time
        && data.note is string
        && data.note.size() <= 300;
    }


    function eligibleForJdnextReward(uid) {
      return isAccountUser()
        && exists(userPath(uid))
        && get(userPath(uid)).data.goldCoins is int
        && get(userPath(uid)).data.goldCoins > -50
        && (!('disabled' in get(userPath(uid)).data)
          || get(userPath(uid)).data.disabled != true);
    }

    function mayPostWithoutJdnextReward(uid) {
      return !isAccountUser()
        || (
          exists(userPath(uid))
          && (
            (('disabled' in get(userPath(uid)).data)
              && get(userPath(uid)).data.disabled == true)
            || !('goldCoins' in get(userPath(uid)).data)
            || !(get(userPath(uid)).data.goldCoins is int)
            || get(userPath(uid)).data.goldCoins <= -50
          )
        );
    }

    function homeworkPath(hwKey, entryId) {
      return /databases/$(database)/documents/jdnextHomework/$(hwKey)/entries/$(entryId);
    }

    function homeworkOwnerPath(hwKey, entryId) {
      return /databases/$(database)/documents/jdnextHomeworkPrivate/$(hwKey)/entries/$(entryId);
    }

    function reportPath(hwKey, entryId, reportUid) {
      return /databases/$(database)/documents/jdnextHomework/$(hwKey)/entries/$(entryId)/reports/$(reportUid);
    }

    function coinEventPath(eventId) {
      return /databases/$(database)/documents/jdnextCoinEvents/$(eventId);
    }

    function homeworkImagePath(hwKey, entryId, imageId) {
      return /databases/$(database)/documents/jdnextHomework/$(hwKey)/entries/$(entryId)/images/$(imageId);
    }

    function imageRefMatches(data, imageId, filename) {
      return data.images is list
        && (
          (data.images.size() > 0 && data.images[0].kind == 'firestore'
            && data.images[0].imageId == imageId && data.images[0].filename == filename)
          ||
          (data.images.size() > 1 && data.images[1].kind == 'firestore'
            && data.images[1].imageId == imageId && data.images[1].filename == filename)
          ||
          (data.images.size() > 2 && data.images[2].kind == 'firestore'
            && data.images[2].imageId == imageId && data.images[2].filename == filename)
        );
    }

    function validFirestoreImagesAfter(hwKey, entryId, images) {
      return images.size() <= 3
        && (images.size() < 1 || images[0].kind != 'firestore'
          || existsAfter(homeworkImagePath(hwKey, entryId, images[0].imageId)))
        && (images.size() < 2 || images[1].kind != 'firestore'
          || existsAfter(homeworkImagePath(hwKey, entryId, images[1].imageId)))
        && (images.size() < 3 || images[2].kind != 'firestore'
          || existsAfter(homeworkImagePath(hwKey, entryId, images[2].imageId)));
    }

    function validPostBatch(uid, eventId) {
      let eventAfter = getAfter(coinEventPath(eventId));
      let d = eventAfter.data;
      let entryPath = homeworkPath(d.hwKey, d.entryId);
      let ownerPath = homeworkOwnerPath(d.hwKey, d.entryId);
      let entryAfter = getAfter(entryPath);
      let ownerAfter = getAfter(ownerPath);
      let profileBefore = get(userPath(uid));
      let profileAfter = getAfter(userPath(uid));

      return signedIn()
        && isAccountUser()
        && request.auth.uid == uid
        && eventId == 'reward-' + d.hwKey + '-' + d.entryId
        && !exists(coinEventPath(eventId))
        && d.uid == uid
        && d.amount == 10
        && d.type == 'homework-post'
        && d.createdAt == request.time
        && !exists(entryPath)
        && !exists(ownerPath)
        && existsAfter(entryPath)
        && existsAfter(ownerPath)
        && entryAfter.data.reportCount == 0
        && ownerAfter.data.authorAuthUid == uid
        && ownerAfter.data.authorTobiUid == uid
        && exists(userPath(uid))
        && (!('disabled' in profileBefore.data) || profileBefore.data.disabled != true)
        && profileBefore.data.goldCoins > -50
        && profileAfter.data.goldCoins == profileBefore.data.goldCoins + 10
        && profileAfter.data.lastJdnextCoinEventId == eventId
        && profileAfter.data.lastProfileChangeAt == request.time;
    }

    function validPenaltyBatch(uid, eventId) {
      let eventAfter = getAfter(coinEventPath(eventId));
      let d = eventAfter.data;
      let entryPath = homeworkPath(d.hwKey, d.entryId);
      let ownerPath = homeworkOwnerPath(d.hwKey, d.entryId);
      let entryBefore = get(entryPath);
      let ownerBefore = get(ownerPath);
      let profileBefore = get(userPath(uid));
      let profileAfter = getAfter(userPath(uid));

      return signedIn()
        && eventId == 'penalty-' + d.hwKey + '-' + d.entryId
        && !exists(coinEventPath(eventId))
        && d.uid == uid
        && d.amount == -20
        && d.type == 'homework-removal'
        && d.createdAt == request.time
        && entryBefore.data.reportCount is int
        && entryBefore.data.reportCount >= 2
        && ownerBefore.data.authorTobiUid == uid
        && exists(userPath(uid))
        && profileAfter.data.goldCoins == profileBefore.data.goldCoins - 20
        && profileAfter.data.lastJdnextCoinEventId == eventId
        && profileAfter.data.lastProfileChangeAt == request.time
        && !existsAfter(entryPath)
        && !existsAfter(ownerPath)
        && (
          (profileAfter.data.goldCoins <= -50 && profileAfter.data.disabled == true)
          ||
          (profileAfter.data.goldCoins > -50
            && (
              (('disabled' in profileBefore.data)
                && profileBefore.data.disabled == true
                && profileAfter.data.disabled == true)
              ||
              ((!('disabled' in profileBefore.data) || profileBefore.data.disabled != true)
                && (!('disabled' in profileAfter.data) || profileAfter.data.disabled != true))
            ))
        );
    }

    function isValidOwnJdnextReward(uid) {
      let eventId = request.resource.data.lastJdnextCoinEventId;
      return request.resource.data.goldCoins == resource.data.goldCoins + 10
        && request.resource.data.lastProfileChangeAt == request.time
        && validPostBatch(uid, eventId);
    }

    function isValidJdnextPenalty(uid) {
      let eventId = request.resource.data.lastJdnextCoinEventId;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'goldCoins', 'disabled', 'lastProfileChangeAt', 'lastJdnextCoinEventId'
        ])
        && validPenaltyBatch(uid, eventId);
    }

    function validRewardEvent(eventId) {
      let d = request.resource.data;
      let profileBefore = get(userPath(d.uid));
      let profileAfter = getAfter(userPath(d.uid));
      let entryPath = homeworkPath(d.hwKey, d.entryId);
      let ownerPath = homeworkOwnerPath(d.hwKey, d.entryId);
      let ownerAfter = getAfter(ownerPath);

      return signedIn()
        && isAccountUser()
        && d.keys().hasAll(['uid', 'amount', 'type', 'hwKey', 'entryId', 'createdAt'])
        && d.keys().hasOnly(['uid', 'amount', 'type', 'hwKey', 'entryId', 'createdAt'])
        && d.uid == request.auth.uid
        && d.amount == 10
        && d.type == 'homework-post'
        && d.hwKey is string
        && d.entryId is string
        && eventId == 'reward-' + d.hwKey + '-' + d.entryId
        && d.createdAt == request.time
        && !exists(coinEventPath(eventId))
        && !exists(entryPath)
        && !exists(ownerPath)
        && existsAfter(entryPath)
        && existsAfter(ownerPath)
        && ownerAfter.data.authorAuthUid == d.uid
        && ownerAfter.data.authorTobiUid == d.uid
        && exists(userPath(d.uid))
        && (!('disabled' in profileBefore.data) || profileBefore.data.disabled != true)
        && profileBefore.data.goldCoins > -50
        && profileAfter.data.goldCoins == profileBefore.data.goldCoins + 10
        && profileAfter.data.lastJdnextCoinEventId == eventId
        && profileAfter.data.lastProfileChangeAt == request.time;
    }

    function validPenaltyEvent(eventId) {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasAll(['uid', 'amount', 'type', 'hwKey', 'entryId', 'createdAt'])
        && d.keys().hasOnly(['uid', 'amount', 'type', 'hwKey', 'entryId', 'createdAt'])
        && d.uid is string
        && d.amount == -20
        && d.type == 'homework-removal'
        && d.hwKey is string
        && d.entryId is string
        && eventId == 'penalty-' + d.hwKey + '-' + d.entryId
        && d.createdAt == request.time
        && validPenaltyBatch(d.uid, eventId);
    }

    // Neue Einträge nutzen ausschließlich geprüfte Firestore-Bilddokumente.
    // Alte Discord-Bildverweise bleiben in bereits vorhandenen Einträgen lesbar.
    function validImage(image) {
      return image is map
        && image.keys().hasAll(['kind', 'imageId', 'filename'])
        && image.keys().hasOnly(['kind', 'imageId', 'filename'])
        && image.kind == 'firestore'
        && image.imageId is string
        && image.imageId.matches('^img[0-2]$')
        && image.filename is string
        && image.filename.size() <= 120;
    }

    function validImages(images) {
      return images is list
        && images.size() <= 3
        && (images.size() < 1 || validImage(images[0]))
        && (images.size() < 2 || validImage(images[1]))
        && (images.size() < 3 || validImage(images[2]));
    }


    // Prices are enforced by Firestore Rules, not trusted from the browser.
    function themePrice(themeId) {
      return themeId == 'RoyalRebels' || themeId == 'Bronze' ? 50
        : themeId == 'Silver' ? 70
        : themeId == 'Gold' ? 100
        : ['Ocean', 'Sunset', 'Forest', 'Candy', 'Midnight', 'Aurora', 'Retro'].hasAny([themeId]) ? 10
        : 0;
    }

    function validThemePurchaseId(themeId) {
      return themeId is string && themePrice(themeId) > 0;
    }

    function validThemeSelection(themeId) {
      return themeId is string
        && ['Next', 'Ocean', 'Sunset', 'Forest', 'Candy', 'Midnight', 'Aurora', 'Retro',
          'RoyalRebels', 'Bronze', 'Silver', 'Gold', 'WinterEvent', 'BirthdayEvent',
          'AdminMatrix', 'HalloweenEvent'].hasAny([themeId]);
    }

    // Ermöglicht die Halloween-Freischaltung am 31. Oktober nach lokaler Uhr
    // in Deutschland oder an der US-Westküste (request.time wird in UTC geprüft).
    function isHalloweenUnlockWindow() {
      return (request.time.month() == 10 && request.time.day() == 30 && request.time.hours() >= 22)
        || (request.time.month() == 10 && request.time.day() == 31)
        || (request.time.month() == 11 && request.time.day() == 1 && request.time.hours() < 7);
    }

    // Ein Kauf ist nur gültig, wenn Profilabbuchung und Event atomar zusammenpassen.
    function validThemePurchaseBatch(uid, eventId) {
      let eventAfter = getAfter(coinEventPath(eventId));
      let d = eventAfter.data;
      let profileBefore = get(userPath(uid));
      let profileAfter = getAfter(userPath(uid));

      return signedIn()
        && isAccountUser()
        && request.auth.uid == uid
        && eventId == 'theme-' + uid + '-' + d.themeId
        && !exists(coinEventPath(eventId))
        && d.uid == uid
        && d.amount == -themePrice(d.themeId)
        && d.type == 'theme-purchase'
        && validThemePurchaseId(d.themeId)
        && d.createdAt == request.time
        && exists(userPath(uid))
        && profileBefore.data.goldCoins is int
        && profileBefore.data.goldCoins >= themePrice(d.themeId)
        && profileAfter.data.goldCoins == profileBefore.data.goldCoins - themePrice(d.themeId)
        && profileAfter.data.lastJdnextCoinEventId == eventId
        && profileAfter.data.lastProfileChangeAt == request.time
        && profileAfter.data.ownedThemes is list
        && (
          (!('ownedThemes' in profileBefore.data)
            && profileAfter.data.ownedThemes.size() == 1
            && profileAfter.data.ownedThemes.hasAny([d.themeId]))
          ||
          (('ownedThemes' in profileBefore.data)
            && profileBefore.data.ownedThemes is list
            && !profileBefore.data.ownedThemes.hasAny([d.themeId])
            && profileAfter.data.ownedThemes.size() == profileBefore.data.ownedThemes.size() + 1
            && profileAfter.data.ownedThemes.hasAll(profileBefore.data.ownedThemes)
            && profileAfter.data.ownedThemes.hasAny([d.themeId]))
        );
    }

    function validThemePurchaseEvent(eventId) {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'amount', 'type', 'themeId', 'createdAt'])
        && d.keys().hasOnly(['uid', 'amount', 'type', 'themeId', 'createdAt'])
        && d.uid is string
        && d.themeId is string
        && eventId == 'theme-' + d.uid + '-' + d.themeId
        && validThemePurchaseBatch(d.uid, eventId);
    }

    function validNewHomeworkEntry(hwKey, entryId) {
      let d = request.resource.data;
      let ownerPath = homeworkOwnerPath(hwKey, entryId);
      let ownerAfter = getAfter(ownerPath);
      let rewardEventId = 'reward-' + hwKey + '-' + entryId;

      return signedIn()
        && d.keys().hasAll(['text', 'author', 'images', 'reportCount', 'createdAt'])
        && d.keys().hasOnly(['text', 'author', 'images', 'reportCount', 'createdAt'])
        && d.text is string
        && d.text.size() >= 3
        && d.text.size() <= 1000
        && d.author is string
        && d.author.size() <= 80
        && validImages(d.images)
        && validFirestoreImagesAfter(hwKey, entryId, d.images)
        && d.reportCount == 0
        && d.createdAt == request.time
        && !exists(homeworkPath(hwKey, entryId))
        && !exists(ownerPath)
        && existsAfter(ownerPath)
        && ownerAfter.data.authorAuthUid == request.auth.uid
        && (
          (isAccountUser() && ownerAfter.data.authorTobiAccountUid == request.auth.uid)
          || (!isAccountUser() && ownerAfter.data.authorTobiAccountUid == null)
        )
        && (
          (ownerAfter.data.authorTobiUid == null
            && mayPostWithoutJdnextReward(request.auth.uid)
            && !existsAfter(coinEventPath(rewardEventId)))
          ||
          (ownerAfter.data.authorTobiUid == request.auth.uid
            && eligibleForJdnextReward(request.auth.uid)
            && validPostBatch(request.auth.uid, rewardEventId))
        );
    }

    function canIncrementReportCount(hwKey, entryId) {
      let reporterPath = reportPath(hwKey, entryId, request.auth.uid);
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && resource.data.reportCount is int
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && !exists(reporterPath)
        && existsAfter(reporterPath)
        && getAfter(reporterPath).data.createdAt == request.time;
    }

    function canRemoveHomework(hwKey, entryId) {
      let ownerPath = homeworkOwnerPath(hwKey, entryId);
      let owner = get(ownerPath);
      let penaltyEventId = 'penalty-' + hwKey + '-' + entryId;
      return signedIn()
        && resource.data.reportCount is int
        && resource.data.reportCount >= 2
        && exists(ownerPath)
        && (
          (owner.data.authorTobiUid == null
            && !existsAfter(coinEventPath(penaltyEventId)))
          ||
          (owner.data.authorTobiUid is string
            && owner.data.authorTobiUid.size() > 0
            && existsAfter(coinEventPath(penaltyEventId))
            && validPenaltyBatch(owner.data.authorTobiUid, penaltyEventId))
        );
    }

    match /users/{uid} {
      allow get: if ownProfile(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if ownProfile(uid)
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'tags', 'goldCoins',
          'authProvider', 'createdAt', 'lastProfileChangeAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.tags == []
        && request.resource.data.goldCoins == 0
        && request.resource.data.authProvider == 'firebase-auth';

      allow update: if (
        ownProfile(uid)
        && isAccountUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profileTitle', 'profileIcon', 'lastProfileChangeAt'
        ])
        && validProfileTitle(request.resource.data.profileTitle)
        && validProfileIcon(request.resource.data.profileIcon)
        && request.resource.data.lastProfileChangeAt == request.time
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tags', 'disabled', 'lastProfileChangeAt', 'email',
          'displayName', 'username', 'authProvider', 'goldCoins',
          'maintenanceBypass'
        ])
        && (uid != request.auth.uid
          || (request.resource.data.tags is list
            && request.resource.data.tags.hasAny(['admin'])
            && (!('disabled' in request.resource.data)
              || request.resource.data.disabled != true)))
        && (!('goldCoins' in request.resource.data)
          || (request.resource.data.goldCoins is int
            && request.resource.data.goldCoins >= -9007199254740991
            && request.resource.data.goldCoins <= 9007199254740991))
        && (!('goldCoins' in request.resource.data)
          || request.resource.data.goldCoins > -50
          || request.resource.data.disabled == true)
        && (!('maintenanceBypass' in request.resource.data)
          || request.resource.data.maintenanceBypass is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['maintenanceBypass'])
          || uid == request.auth.uid)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tags'])
          || (
            exists(/databases/$(database)/documents/siteSettings/accessControl)
            && request.resource.data.tags is list
            && request.resource.data.tags.size() <= 20
            && get(/databases/$(database)/documents/siteSettings/accessControl).data.tags.hasAll(request.resource.data.tags)
          )
        )
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownedThemes', 'equippedTheme', 'lastProfileChangeAt'
        ])
        && request.resource.data.ownedThemes is list
        && request.resource.data.ownedThemes.size() <= 30
        && request.resource.data.lastProfileChangeAt == request.time
        && (
          !('equippedTheme' in request.resource.data)
          || request.resource.data.equippedTheme == 'Next'
          || (
            validThemeSelection(request.resource.data.equippedTheme)
            && request.resource.data.ownedThemes.hasAny([request.resource.data.equippedTheme])
          )
        )
      ) || (
        // Admins may grant/revoke approved event themes for another account.
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownedThemes', 'equippedTheme', 'lastProfileChangeAt'
        ])
        && request.resource.data.ownedThemes is list
        && request.resource.data.ownedThemes.size() <= 30
        && request.resource.data.lastProfileChangeAt == request.time
        && (
          !('equippedTheme' in request.resource.data)
          || request.resource.data.equippedTheme == 'Next'
          || (
            validThemeSelection(request.resource.data.equippedTheme)
            && request.resource.data.ownedThemes.hasAny([request.resource.data.equippedTheme])
          )
        )
      ) || (
        // An account may self-unlock Halloween only once on the event date.
        ownProfile(uid)
        && isAccountUser()
        && isHalloweenUnlockWindow()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownedThemes', 'halloweenUnlockedAt', 'lastProfileChangeAt'
        ])
        && !('halloweenUnlockedAt' in resource.data)
        && request.resource.data.halloweenUnlockedAt == request.time
        && request.resource.data.lastProfileChangeAt == request.time
        && request.resource.data.ownedThemes is list
        && request.resource.data.ownedThemes.size() <= 30
        && request.resource.data.ownedThemes.hasAny(['HalloweenEvent'])
        && (
          (!('ownedThemes' in resource.data)
            && request.resource.data.ownedThemes.size() == 1)
          ||
          (('ownedThemes' in resource.data)
            && resource.data.ownedThemes is list
            && !resource.data.ownedThemes.hasAny(['HalloweenEvent'])
            && request.resource.data.ownedThemes.size() == resource.data.ownedThemes.size() + 1
            && request.resource.data.ownedThemes.hasAll(resource.data.ownedThemes))
        )
      ) || (
        ownProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goldCoins'])
        && !('goldCoins' in resource.data)
        && request.resource.data.goldCoins == 0
      ) || (
        ownProfile(uid)
        && isAccountUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'goldCoins', 'lastProfileChangeAt', 'lastJdnextCoinEventId'
        ])
        && isValidOwnJdnextReward(uid)
      ) || (
        ownProfile(uid)
        && isAccountUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'goldCoins', 'ownedThemes', 'lastProfileChangeAt', 'lastJdnextCoinEventId'
        ])
        && validThemePurchaseBatch(uid, request.resource.data.lastJdnextCoinEventId)
      ) || (
        ownProfile(uid)
        && isAccountUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equippedTheme'])
        && validThemeSelection(request.resource.data.equippedTheme)
        && (
          request.resource.data.equippedTheme == 'Next'
          || (
            ('ownedThemes' in resource.data)
            && resource.data.ownedThemes is list
            && resource.data.ownedThemes.hasAny([request.resource.data.equippedTheme])
          )
        )
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'goldCoins', 'disabled', 'lastProfileChangeAt', 'lastJdnextCoinEventId'
        ])
        && isValidJdnextPenalty(uid)
      );

      allow delete: if false;
    }

    // Public leaderboard mirror: no email, UID field, tags or permissions.
    // A user may only publish the score and cosmetics currently stored in their own profile.
    match /publicProfiles/{uid} {
      // The leaderboard is an admin-only feature, including direct Firestore reads.
      allow get, list: if isAdmin();
      allow create, update: if ownProfile(uid)
        && isAccountUser()
        && exists(userPath(uid))
        && (
          !('disabled' in get(userPath(uid)).data)
          || get(userPath(uid)).data.disabled != true
        )
        && request.resource.data.keys().hasAll([
          'displayName', 'profileTitle', 'profileIcon', 'goldCoins', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'displayName', 'profileTitle', 'profileIcon', 'goldCoins', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.profileTitle == get(userPath(uid)).data.profileTitle
        && request.resource.data.profileIcon == get(userPath(uid)).data.profileIcon
        && request.resource.data.goldCoins == get(userPath(uid)).data.goldCoins
        && validProfileTitle(request.resource.data.profileTitle)
        && validProfileIcon(request.resource.data.profileIcon)
        && request.resource.data.goldCoins is int
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /jdnextHomework/{hwKey}/entries/{entryId} {
      allow read: if true;
      allow create: if validNewHomeworkEntry(hwKey, entryId);
      allow update: if canIncrementReportCount(hwKey, entryId);
      allow delete: if canRemoveHomework(hwKey, entryId);

      match /images/{imageId} {
        allow read: if exists(homeworkPath(hwKey, entryId))
          && imageRefMatches(get(homeworkPath(hwKey, entryId)).data, imageId, resource.data.filename);
        allow create: if signedIn()
          && imageId.matches('^img[0-2]$')
          && request.resource.data.keys().hasAll(['filename', 'dataUrl', 'createdAt'])
          && request.resource.data.keys().hasOnly(['filename', 'dataUrl', 'createdAt'])
          && request.resource.data.filename is string
          && request.resource.data.filename.size() <= 120
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 800000
          && request.resource.data.dataUrl.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
          && request.resource.data.createdAt == request.time
          && !exists(homeworkImagePath(hwKey, entryId, imageId))
          && existsAfter(homeworkPath(hwKey, entryId))
          && imageRefMatches(getAfter(homeworkPath(hwKey, entryId)).data, imageId, request.resource.data.filename);
        allow update: if false;
        allow delete: if signedIn()
          && exists(homeworkPath(hwKey, entryId))
          && get(homeworkPath(hwKey, entryId)).data.reportCount >= 2
          && !existsAfter(homeworkPath(hwKey, entryId))
          && imageRefMatches(get(homeworkPath(hwKey, entryId)).data, imageId, resource.data.filename);
      }

      match /reports/{reportUid} {
        allow read: if false;
        allow create: if signedIn()
          && reportUid == request.auth.uid
          && exists(homeworkPath(hwKey, entryId))
          && exists(homeworkOwnerPath(hwKey, entryId))
          && get(homeworkOwnerPath(hwKey, entryId)).data.authorAuthUid != request.auth.uid
          && !exists(reportPath(hwKey, entryId, reportUid))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(homeworkPath(hwKey, entryId)).data.reportCount
            == get(homeworkPath(hwKey, entryId)).data.reportCount + 1;
        allow update, delete: if false;
      }
    }

    match /jdnextHomeworkPrivate/{hwKey}/entries/{entryId} {
      allow get: if signedIn()
        && exists(homeworkPath(hwKey, entryId))
        && get(homeworkPath(hwKey, entryId)).data.reportCount >= 2;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['authorAuthUid', 'authorTobiUid', 'authorTobiAccountUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorAuthUid', 'authorTobiUid', 'authorTobiAccountUid', 'createdAt'])
        && request.resource.data.authorAuthUid == request.auth.uid
        && (
          (isAccountUser() && request.resource.data.authorTobiAccountUid == request.auth.uid)
          || (!isAccountUser() && request.resource.data.authorTobiAccountUid == null)
        )
        && request.resource.data.createdAt == request.time
        && !exists(homeworkOwnerPath(hwKey, entryId))
        && existsAfter(homeworkPath(hwKey, entryId))
        && getAfter(homeworkPath(hwKey, entryId)).data.reportCount == 0
        && (
          (request.resource.data.authorTobiUid == null
            && mayPostWithoutJdnextReward(request.auth.uid)
            && !existsAfter(coinEventPath('reward-' + hwKey + '-' + entryId)))
          ||
          (request.resource.data.authorTobiUid == request.auth.uid
            && eligibleForJdnextReward(request.auth.uid)
            && validPostBatch(request.auth.uid, 'reward-' + hwKey + '-' + entryId))
        );
      allow update: if false;
      allow delete: if exists(homeworkPath(hwKey, entryId))
        && get(homeworkPath(hwKey, entryId)).data.reportCount >= 2
        && !existsAfter(homeworkPath(hwKey, entryId))
        && (
          (resource.data.authorTobiUid == null
            && !existsAfter(coinEventPath('penalty-' + hwKey + '-' + entryId)))
          ||
          (resource.data.authorTobiUid is string
            && resource.data.authorTobiUid.size() > 0
            && validPenaltyBatch(resource.data.authorTobiUid, 'penalty-' + hwKey + '-' + entryId))
        );
    }

    match /jdnextCoinEvents/{eventId} {
      allow read: if false;
      allow create: if validRewardEvent(eventId) || validPenaltyEvent(eventId) || validThemePurchaseEvent(eventId);
      allow update, delete: if false;
    }

    match /tobiAccounts/{usernameKey} {
      allow read, write: if false;
    }

    match /siteSettings/accessControl {
      // Public read exposes only tag IDs and feature permission lists, not account data.
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() && validAccessControl(request.resource.data);
      allow delete: if false;
    }

    // Public read enables the scheduled GitHub Pages publisher to inspect a pending release request.
    // Only an authenticated active admin can create or change the request.
    match /siteSettings/deployment {
      allow get, list: if true;
      allow create, update: if isAdmin() && validDeploymentRequest(request.resource.data);
      allow delete: if false;
    }

    match /siteSettings/jdnext {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
